# Supabase — public (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase — server only. NEVER expose this to the client.
# Used by Server Actions and the report-generation worker.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Shared secret the app uses to authenticate its own background worker
# invocation and the Vercel Cron sweeper.
WORKER_SECRET=generate-a-long-random-string

# Base URL used to call the worker route from a Server Action.
# On Vercel this is derived automatically; set it for local dev.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
